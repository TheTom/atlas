{
  "hardware": "b200",
  "strategy": "single_node_tp",
  "variant": "nvfp4",
  "node_count": 1,
  "deploy_type": "single_node",
  "env": {
    "VLLM_FLOAT32_MATMUL_PRECISION": "high",
    "VLLM_FLASHINFER_ALLREDUCE_BACKEND": "trtllm"
  },
  "docker_image": "vllm/vllm-openai:minimax-m3",
  "command": "vllm serve nvidia/MiniMax-M3-NVFP4 \\\n  --block-size 128 \\\n  --trust-remote-code \\\n  --kv-cache-dtype fp8 \\\n  --attention_config.backend FLASHINFER \\\n  --attention_config.use_trtllm_attention true \\\n  --attention_config.indexer_kv_dtype fp8 \\\n  --attention_config.minimax_m3_msa_decode_backend cutlass \\\n  --tensor-parallel-size 8 \\\n  --tool-call-parser minimax_m3 \\\n  --enable-auto-tool-choice \\\n  --reasoning-parser minimax_m3",
  "argv": [
    "vllm",
    "serve",
    "nvidia/MiniMax-M3-NVFP4",
    "--block-size",
    "128",
    "--trust-remote-code",
    "--kv-cache-dtype",
    "fp8",
    "--attention_config.backend",
    "FLASHINFER",
    "--attention_config.use_trtllm_attention",
    "true",
    "--attention_config.indexer_kv_dtype",
    "fp8",
    "--attention_config.minimax_m3_msa_decode_backend",
    "cutlass",
    "--tensor-parallel-size",
    "8",
    "--tool-call-parser",
    "minimax_m3",
    "--enable-auto-tool-choice",
    "--reasoning-parser",
    "minimax_m3"
  ],
  "docker_command": "docker run --gpus all \\\n  --privileged --ipc=host -p 8000:8000 \\\n  -v ~/.cache/huggingface:/root/.cache/huggingface \\\n  -e VLLM_FLOAT32_MATMUL_PRECISION=high \\\n  -e VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm \\\n  vllm/vllm-openai:minimax-m3 nvidia/MiniMax-M3-NVFP4 \\\n  --block-size 128 \\\n  --trust-remote-code \\\n  --kv-cache-dtype fp8 \\\n  --attention_config.backend FLASHINFER \\\n  --attention_config.use_trtllm_attention true \\\n  --attention_config.indexer_kv_dtype fp8 \\\n  --attention_config.minimax_m3_msa_decode_backend cutlass \\\n  --tensor-parallel-size 8 \\\n  --tool-call-parser minimax_m3 \\\n  --enable-auto-tool-choice \\\n  --reasoning-parser minimax_m3",
  "docker_argv": [
    "docker",
    "run",
    "--gpus",
    "all",
    "--privileged",
    "--ipc=host",
    "-p",
    "8000:8000",
    "-v",
    "~/.cache/huggingface:/root/.cache/huggingface",
    "-e",
    "VLLM_FLOAT32_MATMUL_PRECISION=high",
    "-e",
    "VLLM_FLASHINFER_ALLREDUCE_BACKEND=trtllm",
    "vllm/vllm-openai:minimax-m3",
    "nvidia/MiniMax-M3-NVFP4",
    "--block-size",
    "128",
    "--trust-remote-code",
    "--kv-cache-dtype",
    "fp8",
    "--attention_config.backend",
    "FLASHINFER",
    "--attention_config.use_trtllm_attention",
    "true",
    "--attention_config.indexer_kv_dtype",
    "fp8",
    "--attention_config.minimax_m3_msa_decode_backend",
    "cutlass",
    "--tensor-parallel-size",
    "8",
    "--tool-call-parser",
    "minimax_m3",
    "--enable-auto-tool-choice",
    "--reasoning-parser",
    "minimax_m3"
  ],
  "strategy_spec": {
    "name": "single_node_tp",
    "deploy_type": "single_node",
    "display_name": "Tensor Parallel",
    "orientation": "latency",
    "description": "Single-node tensor parallel. Splits the model across all local GPUs. TP size is set to the GPU count at deploy time. The simplest multi-GPU strategy — works for all model architectures.\n",
    "hardware_match": {
      "min_gpus": 1,
      "max_gpus": 8,
      "multi_node": false
    },
    "vllm_args": [],
    "parallel_flag": "--tensor-parallel-size"
  },
  "hardware_profile": {
    "brand": "NVIDIA",
    "generation": "blackwell",
    "display_name": "B200",
    "description": "NVIDIA B200 SXM 180 GB HBM3e · 8-GPU HGX B200 node",
    "gpu_count": 8,
    "vram_gb": 1440,
    "multi_node": false
  },
  "alternatives": {
    "single_node_tep": "/nvidia/MiniMax-M3-NVFP4/strategies/single_node_tep.json",
    "single_node_dep": "/nvidia/MiniMax-M3-NVFP4/strategies/single_node_dep.json",
    "multi_node_tp": "/nvidia/MiniMax-M3-NVFP4/strategies/multi_node_tp.json",
    "multi_node_tp_pp": "/nvidia/MiniMax-M3-NVFP4/strategies/multi_node_tp_pp.json",
    "multi_node_tep": "/nvidia/MiniMax-M3-NVFP4/strategies/multi_node_tep.json",
    "multi_node_dep": "/nvidia/MiniMax-M3-NVFP4/strategies/multi_node_dep.json",
    "pd_cluster": "/nvidia/MiniMax-M3-NVFP4/strategies/pd_cluster.json",
    "kv_store_centralized_mooncake": "/nvidia/MiniMax-M3-NVFP4/strategies/kv_store_centralized_mooncake.json",
    "kv_store_distributed_mooncake": "/nvidia/MiniMax-M3-NVFP4/strategies/kv_store_distributed_mooncake.json"
  }
}