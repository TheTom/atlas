root_0 ::= ((param root_1)) (=("\n</function>\n</tool_call>"))
param ::= (("<parameter=" paramname ">" value "</parameter>"))
paramname ::= (("city") | ("days")) (=(">" value "</parameter>"))
value ::= (([ \t\r\n]* nonempty_value)) (=("</parameter>"))
nonempty_value ::= (([^ \t\r\n<=>] rest) | ("<" [^/] rest) | ("</" [^p] rest) | ("</p" [^a] rest) | ("</pa" [^r] rest) | ("</par" [^a] rest) | ("</para" [^m] rest) | ("</param" [^e] rest) | ("</parame" [^t] rest) | ("</paramet" [^e] rest) | ("</paramete" [^r] rest) | ("</parameter" [^>] rest))
rest ::= ((rest_1))
root_1 ::= ("" | ("\n" param root_1))
rest_1 ::= ("" | ([^<] rest_1) | ("<" [^/] rest_1) | ("</" [^p] rest_1) | ("</p" [^a] rest_1) | ("</pa" [^r] rest_1) | ("</par" [^a] rest_1) | ("</para" [^m] rest_1) | ("</param" [^e] rest_1) | ("</parame" [^t] rest_1) | ("</paramet" [^e] rest_1) | ("</paramete" [^r] rest_1) | ("</parameter" [^>] rest_1))
triggered_tags ::= (("<tool_call>\n<function=get_weather>\n" root_0 "\n</function>\n</tool_call>"))
root ::= ((triggered_tags))
