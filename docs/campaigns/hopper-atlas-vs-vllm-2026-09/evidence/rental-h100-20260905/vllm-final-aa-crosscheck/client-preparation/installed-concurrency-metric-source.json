{"serve.py": {"sha256": "999939debed5ccebaa2e31d5a196c494c9b0ccac993dc85191737324c0bee497", "lines": [{"line": 667, "text": "    if successful_outputs:"}, {"line": 668, "text": "        min_start_time = min(output.start_time for output in successful_outputs)"}, {"line": 669, "text": "        max_end_time = max("}, {"line": 670, "text": "            output.start_time + output.latency for output in successful_outputs"}, {"line": 671, "text": "        )"}, {"line": 672, "text": ""}, {"line": 673, "text": "        # Create second buckets (ceiling to ensure we capture all time)"}, {"line": 674, "text": "        duration_seconds = int(np.ceil(max_end_time - min_start_time)) + 1"}, {"line": 675, "text": "        tokens_per_second = np.zeros(duration_seconds)"}, {"line": 676, "text": "        concurrent_requests_per_second = np.zeros(duration_seconds)"}, {"line": 677, "text": ""}, {"line": 678, "text": "        for i, output in enumerate(successful_outputs):"}, {"line": 679, "text": "            # Calculate token generation timestamp using"}, {"line": 680, "text": "            # start_time, ttft, and itl"}, {"line": 681, "text": "            token_times = [output.start_time + output.ttft]"}, {"line": 682, "text": "            current_time = token_times[0]"}, {"line": 683, "text": "            for itl_value in output.itl:"}, {"line": 684, "text": "                current_time += itl_value"}, {"line": 685, "text": "                token_times.append(current_time)"}, {"line": 686, "text": ""}, {"line": 687, "text": "            # Add tokens to second buckets"}, {"line": 688, "text": "            for token_time in token_times:"}, {"line": 689, "text": "                second_bucket = int(token_time - min_start_time)"}, {"line": 690, "text": "                if 0 <= second_bucket < duration_seconds:"}, {"line": 691, "text": "                    tokens_per_second[second_bucket] += 1"}, {"line": 692, "text": ""}, {"line": 693, "text": "            # Track concurrent requests for each second this request was active"}, {"line": 694, "text": "            request_start_second = int(output.start_time - min_start_time)"}, {"line": 695, "text": "            request_end_second = int("}, {"line": 696, "text": "                (output.start_time + output.latency) - min_start_time"}, {"line": 697, "text": "            )"}, {"line": 698, "text": ""}, {"line": 699, "text": "            for second in range(request_start_second, request_end_second + 1):"}, {"line": 700, "text": "                concurrent_requests_per_second[second] += 1"}, {"line": 701, "text": ""}, {"line": 702, "text": "        # Find the maximum tokens per second and corresponding"}, {"line": 703, "text": "        # concurrent requests"}, {"line": 704, "text": "        if len(tokens_per_second) > 0:"}, {"line": 705, "text": "            max_output_tokens_per_s = float(np.max(tokens_per_second))"}, {"line": 706, "text": "            max_concurrent_requests = int(np.max(concurrent_requests_per_second))"}, {"line": 707, "text": ""}, {"line": 910, "text": "                    lora_modules_list[i % len(lora_modules_list)]"}, {"line": 911, "text": "                    for i in range(len(input_requests))"}, {"line": 912, "text": "                ]"}, {"line": 913, "text": "            )"}, {"line": 914, "text": "        else:"}, {"line": 915, "text": "            # For each input request, choose a LoRA module at random."}, {"line": 916, "text": "            lora_modules_iter = iter("}, {"line": 917, "text": "                [random.choice(lora_modules_list) for _ in range(len(input_requests))]"}, {"line": 918, "text": "            )"}, {"line": 919, "text": ""}, {"line": 920, "text": "    if profile:"}, {"line": 921, "text": "        print(\"Starting profiler...\")"}, {"line": 922, "text": "        profile_input = RequestFuncInput("}, {"line": 923, "text": "            model=model_id,"}, {"line": 924, "text": "            model_name=model_name,"}, {"line": 925, "text": "            prompt=test_prompt,"}, {"line": 926, "text": "            api_url=base_url + \"/start_profile\","}, {"line": 927, "text": "            prompt_len=test_prompt_len,"}, {"line": 928, "text": "            output_len=test_output_len,"}, {"line": 929, "text": "            logprobs=logprobs,"}, {"line": 930, "text": "            multi_modal_content=test_mm_content,"}, {"line": 931, "text": "            ignore_eos=ignore_eos,"}, {"line": 932, "text": "            extra_headers=extra_headers,"}, {"line": 933, "text": "            extra_body=test_extra_body,"}, {"line": 934, "text": "            chat_messages=test_chat_messages,"}, {"line": 935, "text": "        )"}, {"line": 936, "text": "        profile_output = await request_func("}, {"line": 937, "text": "            request_func_input=profile_input, session=session"}, {"line": 938, "text": "        )"}, {"line": 939, "text": "        if profile_output.success:"}, {"line": 940, "text": "            print(\"Profiler started\")"}, {"line": 941, "text": ""}, {"line": 942, "text": "    distribution = \"Poisson process\" if burstiness == 1.0 else \"Gamma distribution\""}, {"line": 943, "text": "    if not self_timed:"}, {"line": 944, "text": "        if ramp_up_strategy is not None:"}, {"line": 945, "text": "            print(f\"Traffic ramp-up strategy: {ramp_up_strategy}.\")"}, {"line": 946, "text": "            print("}, {"line": 947, "text": "                f\"Will increase RPS from {ramp_up_start_rps} to \""}, {"line": 948, "text": "                f\"{ramp_up_end_rps} RPS over the duration of the benchmark.\""}, {"line": 949, "text": "            )"}, {"line": 950, "text": "        else:"}, {"line": 951, "text": "            print(f\"Traffic request rate: {request_rate}\")"}, {"line": 952, "text": ""}, {"line": 953, "text": "        print(f\"Burstiness factor: {burstiness} ({distribution})\")"}, {"line": 954, "text": "        print(f\"Maximum request concurrency: {max_concurrency}\")"}, {"line": 955, "text": "    else:"}, {"line": 956, "text": "        print(\"Self timing is set, using the timestamps from the trace file.\")"}, {"line": 957, "text": ""}, {"line": 958, "text": "    spec_decode_metrics_before = await fetch_spec_decode_metrics(base_url, session)"}, {"line": 959, "text": "    diffusion_metrics_before = await fetch_diffusion_metrics(base_url, session)"}, {"line": 960, "text": ""}, {"line": 961, "text": "    pbar = None if disable_tqdm else tqdm(total=len(input_requests))"}, {"line": 962, "text": ""}, {"line": 963, "text": "    semaphore = ("}, {"line": 964, "text": "        asyncio.Semaphore(max_concurrency)"}, {"line": 965, "text": "        if max_concurrency"}, {"line": 966, "text": "        else contextlib.nullcontext()"}, {"line": 967, "text": "    )"}, {"line": 968, "text": ""}, {"line": 969, "text": "    async def limited_request_func(request_func_input, session, pbar):"}, {"line": 970, "text": "        async with semaphore:"}, {"line": 971, "text": "            return await request_func("}, {"line": 972, "text": "                request_func_input=request_func_input, session=session, pbar=pbar"}, {"line": 973, "text": "            )"}, {"line": 974, "text": ""}, {"line": 975, "text": "    probe_outputs: list[RequestFuncOutput] = []"}, {"line": 976, "text": "    probe_stop = asyncio.Event()"}, {"line": 977, "text": ""}, {"line": 978, "text": "    async def probe_loop():"}, {"line": 979, "text": "        probe_input = replace("}, {"line": 980, "text": "            test_input,"}, {"line": 981, "text": "            prompt=\"Hi\","}, {"line": 982, "text": "            prompt_len=1,"}, {"line": 983, "text": "            output_len=1,"}, {"line": 984, "text": "            multi_modal_content=None,"}, {"line": 985, "text": "            chat_messages=None,"}, {"line": 986, "text": "        )"}, {"line": 987, "text": "        interval = 1 / probe_request_rate"}, {"line": 988, "text": "        while not probe_stop.is_set():"}, {"line": 989, "text": "            probe_outputs.append("}, {"line": 990, "text": "                await request_func(request_func_input=probe_input, session=session)"}, {"line": 991, "text": "            )"}, {"line": 992, "text": "            await asyncio.sleep(interval)"}, {"line": 993, "text": ""}, {"line": 994, "text": "    probe_task: asyncio.Task | None = None"}, {"line": 995, "text": "    if probe_request_rate > 0:"}, {"line": 996, "text": "        print(f\"Probe request rate: {probe_request_rate} req/s\")"}, {"line": 997, "text": "        probe_task = asyncio.create_task(probe_loop())"}, {"line": 998, "text": ""}, {"line": 999, "text": "    benchmark_start_time = time.perf_counter()"}, {"line": 1000, "text": "    tasks: list[asyncio.Task] = []"}, {"line": 1001, "text": ""}, {"line": 1002, "text": "    rps_change_events = []"}, {"line": 1003, "text": "    last_int_rps = -1"}, {"line": 1004, "text": "    if ramp_up_strategy is not None and ramp_up_start_rps is not None:"}, {"line": 1005, "text": "        last_int_rps = ramp_up_start_rps"}, {"line": 1006, "text": "        rps_change_events.append("}, {"line": 1007, "text": "            {"}, {"line": 1008, "text": "                \"rps\": last_int_rps,"}, {"line": 1009, "text": "                \"timestamp\": datetime.now().isoformat(),"}, {"line": 1010, "text": "            }"}, {"line": 1011, "text": "        )"}, {"line": 1012, "text": ""}, {"line": 1013, "text": "    async for request, current_request_rate in get_request("}, {"line": 1014, "text": "        input_requests,"}, {"line": 1015, "text": "        request_rate,"}, {"line": 1016, "text": "        burstiness,"}, {"line": 1017, "text": "        ramp_up_strategy,"}, {"line": 1018, "text": "        ramp_up_start_rps,"}, {"line": 1019, "text": "        ramp_up_end_rps,"}, {"line": 1020, "text": "        self_timed,"}]}, "lib/endpoint_request_func.py": {"sha256": "1144469df5e1ded48dcd1c6b8720f329e46b4e2653b5c2a4f9b5961927f274a6", "lines": [{"line": 205, "text": ""}, {"line": 206, "text": "                async for chunk_bytes in response.content.iter_any():"}, {"line": 207, "text": "                    chunk_bytes = chunk_bytes.strip()"}, {"line": 208, "text": "                    if not chunk_bytes:"}, {"line": 209, "text": "                        continue"}, {"line": 210, "text": ""}, {"line": 211, "text": "                    messages = handler.add_chunk(chunk_bytes)"}, {"line": 212, "text": "                    for message in messages:"}, {"line": 213, "text": "                        # NOTE: SSE comments (often used as pings) start with"}, {"line": 214, "text": "                        # a colon. These are not JSON data payload and should"}, {"line": 215, "text": "                        # be skipped."}, {"line": 216, "text": "                        if message.startswith(\":\"):"}, {"line": 217, "text": "                            continue"}, {"line": 218, "text": ""}, {"line": 219, "text": "                        chunk = message.removeprefix(\"data: \")"}, {"line": 220, "text": ""}, {"line": 221, "text": "                        if chunk != \"[DONE]\":"}, {"line": 222, "text": "                            data = json.loads(chunk)"}, {"line": 223, "text": ""}, {"line": 224, "text": "                            # NOTE: Some completion API might have a last"}, {"line": 225, "text": "                            # usage summary response without a token so we"}, {"line": 226, "text": "                            # want to check a token was generated"}, {"line": 227, "text": "                            if choices := data.get(\"choices\"):"}, {"line": 228, "text": "                                # Note that text could be empty here"}, {"line": 229, "text": "                                # e.g. for special tokens"}, {"line": 230, "text": "                                text = choices[0].get(\"text\")"}, {"line": 231, "text": "                                timestamp = time.perf_counter()"}, {"line": 232, "text": "                                # First token"}, {"line": 233, "text": "                                if not first_chunk_received:"}, {"line": 234, "text": "                                    first_chunk_received = True"}, {"line": 235, "text": "                                    ttft = time.perf_counter() - st"}, {"line": 236, "text": "                                    output.ttft = ttft"}, {"line": 237, "text": ""}, {"line": 238, "text": "                                # Decoding phase"}, {"line": 239, "text": "                                else:"}, {"line": 240, "text": "                                    output.itl.append(timestamp - most_recent_timestamp)"}, {"line": 241, "text": ""}, {"line": 242, "text": "                                most_recent_timestamp = timestamp"}, {"line": 243, "text": "                                generated_text += text or \"\""}, {"line": 244, "text": "                            elif usage := data.get(\"usage\"):"}, {"line": 245, "text": "                                output.output_tokens = usage.get(\"completion_tokens\")"}, {"line": 246, "text": "                                if (pt := usage.get(\"prompt_tokens\")) is not None:"}, {"line": 247, "text": "                                    output.prompt_len = pt"}, {"line": 248, "text": "                if first_chunk_received:"}, {"line": 249, "text": "                    output.success = True"}, {"line": 250, "text": "                else:"}, {"line": 251, "text": "                    output.success = False"}, {"line": 252, "text": "                    output.error = ("}, {"line": 253, "text": "                        \"Never received a valid chunk to calculate TTFT.\""}, {"line": 254, "text": "                        \"This response will be marked as failed!\""}, {"line": 255, "text": "                    )"}, {"line": 256, "text": "                output.generated_text = generated_text"}, {"line": 257, "text": "                output.latency = most_recent_timestamp - st"}, {"line": 258, "text": "            