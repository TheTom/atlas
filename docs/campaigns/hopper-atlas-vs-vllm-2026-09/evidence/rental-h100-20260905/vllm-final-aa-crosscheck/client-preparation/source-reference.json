{"benchmarks/serve.py": {"sha256": "999939debed5ccebaa2e31d5a196c494c9b0ccac993dc85191737324c0bee497", "lines": [{"line": 16, "text": "        --output-len <general output length. Optional, maps to dataset-specific args> \\"}, {"line": 17, "text": "        --request-rate <request_rate. Default inf> \\"}, {"line": 18, "text": "        --num-prompts <num_prompts. Default 1000>"}, {"line": 19, "text": "\"\"\""}, {"line": 20, "text": ""}, {"line": 21, "text": "import argparse"}, {"line": 22, "text": "import asyncio"}, {"line": 23, "text": "import contextlib"}, {"line": 24, "text": "import importlib.util"}, {"line": 25, "text": "import json"}, {"line": 26, "text": "import os"}, {"line": 27, "text": "import random"}, {"line": 96, "text": "                    json={"}, {"line": 97, "text": "                        \"model\": model_id,"}, {"line": 98, "text": "                        \"prompt\": prompt,"}, {"line": 99, "text": "                        \"add_special_tokens\": False,"}, {"line": 100, "text": "                    },"}, {"line": 101, "text": "                ) as r,"}, {"line": 102, "text": "            ):"}, {"line": 103, "text": "                r.raise_for_status()"}, {"line": 104, "text": "                return (await r.json())[\"tokens\"]"}, {"line": 105, "text": ""}, {"line": 106, "text": "        async def _detokenize(tokens: list[int]) -> str:"}, {"line": 107, "text": "            async with ("}, {"line": 779, "text": "    burstiness: float,"}, {"line": 780, "text": "    disable_tqdm: bool,"}, {"line": 781, "text": "    num_warmups: int,"}, {"line": 782, "text": "    profile: bool,"}, {"line": 783, "text": "    selected_percentile_metrics: list[str],"}, {"line": 784, "text": "    selected_percentiles: list[float],"}, {"line": 785, "text": "    ignore_eos: bool,"}, {"line": 786, "text": "    goodput_config_dict: dict[str, float],"}, {"line": 787, "text": "    max_concurrency: int | None,"}, {"line": 788, "text": "    lora_modules: Iterable[str] | None,"}, {"line": 789, "text": "    extra_headers: dict | None,"}, {"line": 790, "text": "    extra_body: dict | None,"}, {"line": 823, "text": "    )"}, {"line": 824, "text": ""}, {"line": 825, "text": "    print(\"Starting initial single prompt test run...\")"}, {"line": 826, "text": "    test_prompt, test_prompt_len, test_output_len, test_mm_content = ("}, {"line": 827, "text": "        input_requests[0].prompt,"}, {"line": 828, "text": "        input_requests[0].prompt_len,"}, {"line": 829, "text": "        input_requests[0].expected_output_len,"}, {"line": 830, "text": "        input_requests[0].multi_modal_data,"}, {"line": 831, "text": "    )"}, {"line": 832, "text": "    test_extra_body = _merge_overrides(extra_body, input_requests[0].request_overrides)"}, {"line": 833, "text": "    test_chat_messages = input_requests[0].chat_messages"}, {"line": 834, "text": ""}, {"line": 865, "text": "        if not test_output.success:"}, {"line": 866, "text": "            raise ValueError("}, {"line": 867, "text": "                \"Initial test run failed - Please make sure benchmark \""}, {"line": 868, "text": "                \"arguments are correctly specified. \""}, {"line": 869, "text": "                f\"Error: {test_output.error}\""}, {"line": 870, "text": "            )"}, {"line": 871, "text": "        else:"}, {"line": 872, "text": "            print(\"Initial test run completed.\")"}, {"line": 873, "text": "    else:"}, {"line": 874, "text": "        print(\"Skipping endpoint ready check.\")"}, {"line": 875, "text": ""}, {"line": 876, "text": "    if num_warmups > 0:"}, {"line": 877, "text": "        print(f\"Warming up with {num_warmups} requests...\")"}, {"line": 878, "text": "        warmup_pbar = None if disable_tqdm else tqdm(total=num_warmups)"}, {"line": 879, "text": "        warmup_semaphore = ("}, {"line": 880, "text": "            asyncio.Semaphore(max_concurrency)"}, {"line": 881, "text": "            if max_concurrency"}, {"line": 882, "text": "            else contextlib.nullcontext()"}, {"line": 883, "text": "        )"}, {"line": 884, "text": "        warmup_tasks = []"}, {"line": 885, "text": ""}, {"line": 886, "text": "        async def warmup_limited_request_func():"}, {"line": 887, "text": "            async with warmup_semaphore:"}, {"line": 890, "text": "                )"}, {"line": 891, "text": ""}, {"line": 892, "text": "        for _ in range(num_warmups):"}, {"line": 893, "text": "            request_task = asyncio.create_task(warmup_limited_request_func())"}, {"line": 894, "text": "            warmup_tasks.append(request_task)"}, {"line": 895, "text": "        _ = await asyncio.gather(*warmup_tasks)"}, {"line": 896, "text": ""}, {"line": 897, "text": "        if warmup_pbar is not None:"}, {"line": 898, "text": "            warmup_pbar.close()"}, {"line": 899, "text": "        print(\"Warmup run completed.\")"}, {"line": 900, "text": ""}, {"line": 901, "text": "    print(\"Starting main benchmark run...\")"}, {"line": 1587, "text": "    )"}, {"line": 1588, "text": "    parser.add_argument("}, {"line": 1589, "text": "        \"--max-concurrency\","}, {"line": 1590, "text": "        type=int,"}, {"line": 1591, "text": "        default=None,"}, {"line": 1592, "text": "        help=\"Maximum number of concurrent requests. This can be used \""}, {"line": 1593, "text": "        \"to help simulate an environment where a higher level component \""}, {"line": 1594, "text": "        \"is enforcing a maximum number of concurrent requests. While the \""}, {"line": 1595, "text": "        \"--request-rate argument controls the rate at which requests are \""}, {"line": 1596, "text": "        \"initiated, this argument will control how many are actually allowed \""}, {"line": 1597, "text": "        \"to execute at a time. This means that when used in combination, the \""}, {"line": 1598, "text": "        \"actual request rate may be lower than specified with --request-rate, \""}, {"line": 1613, "text": "        de